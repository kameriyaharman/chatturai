# ─────────────────────────────────────────────────────────────
#  chatturai.com — React front-end + existing Yii (PHP) backend
#  React serves:  /  /portfolio  /about-us  /contact  /privacy-policy  /terms-condition
#            /book-a-call (form step)  /admin (new enquiry admin)
#  PHP still serves everything else: /booked, /thank-you, /site/save-booking,
#  /site/meta-track, the Calendly step, and the contact/booking form backends.
# ─────────────────────────────────────────────────────────────

Options -MultiViews
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# 1) Contact / booking forms → Yii backend (token fetch + submit), same as before
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^(contact|book-a-call)/?$ index.php [L]
RewriteCond %{QUERY_STRING} (^|&)legacy=1(&|$)
RewriteRule ^(contact|book-a-call)/?$ index.php [L]

# 2) React pages (prerendered HTML files)
RewriteRule ^(portfolio|about-us|contact|privacy-policy|terms-condition|book-a-call)/?$ $1.html [L]

# 2b) New enquiry admin (replaces the old Yii admin panel)
RewriteRule ^admin(/.*)?$ admin.html [L]

# 3) Real files and folders (css, images, media, react-assets …) are served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4) Everything else → Yii, exactly as it worked before
RewriteRule . index.php [L]

# Don't cache the HTML pages, so a new deploy shows up immediately
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^react-assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
